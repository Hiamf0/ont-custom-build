+/// The user's own macro goals in grams and the energy each provides.
+class _CustomMacroGoalsCard extends StatelessWidget {
+  final KcalGoalBreakdownEntity breakdown;
+
+  const _CustomMacroGoalsCard({required this.breakdown});
+
+  @override
+  Widget build(BuildContext context) {
+    final l10n = S.of(context);
+    // The gram goals include today's activity share; the custom grams are
+    // what is left after taking it back out.
+    final activity = breakdown.activityKcal;
+    final carbs =
+        breakdown.carbsGoalGrams - MacroCalc.getTotalCarbsGoal(activity);
+    final fats = breakdown.fatsGoalGrams - MacroCalc.getTotalFatsGoal(activity);
+    final proteins =
+        breakdown.proteinsGoalGrams - MacroCalc.getTotalProteinsGoal(activity);
+    return _SectionCard(
+      title: l10n.kcalGoalInfoCustomMacrosSection,
+      children: [
+        _FormulaText.raw(
+          text:
+              '${l10n.carbsLabel}: '
+              '${_line(carbs, MacroCalc.carbsKcalPerGram)}\n'
+              '${l10n.fatLabel}: '
+              '${_line(fats, MacroCalc.fatKcalPerGram)}\n'
+              '${l10n.proteinLabel}: '
+              '${_line(proteins, MacroCalc.proteinKcalPerGram)}',
+        ),
+        const Divider(height: Dimens.spacing20),
+        _ValueRow(
+          label: l10n.kcalGoalInfoCustomMacrosSection,
+          value: EnergyDisplay.formatWithUnit(
+            context,
+            breakdown.customMacroGoalsKcal!,
+          ),
+          emphasized: true,
+        ),
+      ],
+    );
+  }
+
+  String _line(double grams, double kcalPerGram) {
+    final density = kcalPerGram.toStringAsFixed(0);
+    return '${grams.round()} g × $density = ${(grams * kcalPerGram).round()}';
+  }
+}
