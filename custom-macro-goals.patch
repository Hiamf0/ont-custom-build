index 0000000..7c4be45
--- /dev/null
+++ b/lib/features/settings/presentation/widgets/custom_kcal_goal_dialog.dart
@@ -0,0 +1,187 @@
+import 'package:flutter/material.dart';
+import 'package:flutter/services.dart';
+import 'package:opennutritracker/core/utils/calc/unit_calc.dart';
+import 'package:opennutritracker/core/utils/energy_unit_provider.dart';
+import 'package:opennutritracker/core/utils/reload_diary_and_trends.dart';
+import 'package:opennutritracker/features/home/presentation/bloc/home_bloc.dart';
+import 'package:opennutritracker/features/settings/presentation/bloc/settings_bloc.dart';
+import 'package:opennutritracker/generated/l10n.dart';
+import 'package:provider/provider.dart';
+
+/// Lets the user enter their own daily kcal goal instead of the calculated
+/// one. Logged activity still adds on top, and the macro goals are split
+/// from it by the macro split — see `GetKcalGoalUsecase`.
+class CustomKcalGoalDialog extends StatefulWidget {
+  /// Allowed range for the goal, in kcal.
+  static const double minKcalGoal = 500;
+  static const double maxKcalGoal = 10000;
+
+  final SettingsBloc settingsBloc;
+  final HomeBloc homeBloc;
+
+  const CustomKcalGoalDialog({
+    super.key,
+    required this.settingsBloc,
+    required this.homeBloc,
+  });
+
+  @override
+  State<CustomKcalGoalDialog> createState() => _CustomKcalGoalDialogState();
+}
+
+class _CustomKcalGoalDialogState extends State<CustomKcalGoalDialog> {
+  bool _loaded = false;
+  bool _enabled = false;
+
+  /// The goal the field was filled with, in kcal. Kept so an untouched kJ
+  /// field (a rounded conversion) saves the original value instead of
+  /// drifting by a fraction each time (#1371).
+  double _loadedKcal = 0;
+  bool _textEdited = false;
+
+  late final TextEditingController _controller;
+
+  bool get _usesKj =>
+      Provider.of<EnergyUnitProvider>(context, listen: false).usesKilojoules;
+
+  @override
+  void initState() {
+    super.initState();
+    _controller = TextEditingController();
+    _load();
+  }
+
+  @override
+  void dispose() {
+    _controller.dispose();
+    super.dispose();
+  }
+
+  Future<void> _load() async {
+    final custom = await widget.settingsBloc.getCustomKcalGoal();
+    // Off: start from the goal the dashboard shows today.
+    final kcal = custom ?? await widget.settingsBloc.getBaseKcalGoal();
+    if (!mounted) return;
+    setState(() {
+      _enabled = custom != null;
+      _loadedKcal = kcal.roundToDouble();
+      _controller.text = _toDisplay(_loadedKcal).round().toString();
+      _loaded = true;
+    });
+  }
+
+  double _toDisplay(double kcal) => _usesKj ? UnitCalc.kcalToKj(kcal) : kcal;
+
+  /// The entered goal in kcal, or null when it is empty or out of range.
+  double? get _kcal {
+    if (!_textEdited) return _loadedKcal;
+    final typed = int.tryParse(_controller.text);
+    if (typed == null) return null;
+    final kcal = (_usesKj ? UnitCalc.kjToKcal(typed.toDouble()) : typed)
+        .roundToDouble();
+    if (kcal < CustomKcalGoalDialog.minKcalGoal ||
+        kcal > CustomKcalGoalDialog.maxKcalGoal) {
+      return null;
+    }
+    return kcal;
+  }
+
+  Future<void> _save() async {
+    final kcal = _kcal;
+    if (_enabled && kcal == null) return;
+    await widget.settingsBloc.setCustomKcalGoal(_enabled ? kcal : null);
+    widget.settingsBloc.add(LoadSettingsEvent());
+    widget.homeBloc.add(const LoadItemsEvent());
+    // Recompute today's stored goals so the diary reflects the change
+    // straight away instead of from tomorrow on.
+    await widget.settingsBloc.updateTrackedDay(
+      await widget.settingsBloc.getCurrentLogicalDay(),
+    );
+    reloadDiaryAndTrends();
+    if (!mounted) return;
+    Navigator.of(context).pop();
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    final s = S.of(context);
+    final usesKj = context.watch<EnergyUnitProvider>().usesKilojoules;
+    final invalid = _enabled && _kcal == null;
+    final canSave = _loaded && !invalid;
+    return AlertDialog(
+      title: Text(
+        s.settingsCustomKcalGoalLabel,
+        maxLines: 2,
+        overflow: TextOverflow.ellipsis,
+      ),
+      content: !_loaded
+          ? const SizedBox(
+              height: 80,
+              child: Center(child: CircularProgressIndicator()),
+            )
+          : SingleChildScrollView(
+              child: Column(
+                mainAxisSize: MainAxisSize.min,
+                crossAxisAlignment: CrossAxisAlignment.stretch,
+                children: [
+                  Semantics(
+                    identifier: 'custom-kcal-goal-switch',
+                    child: SwitchListTile(
+                      contentPadding: EdgeInsets.zero,
