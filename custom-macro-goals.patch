+import 'package:flutter/material.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:opennutritracker/core/utils/energy_unit_provider.dart';
+import 'package:opennutritracker/core/utils/locator.dart';
+import 'package:opennutritracker/features/home/presentation/bloc/home_bloc.dart';
+import 'package:opennutritracker/features/settings/presentation/bloc/settings_bloc.dart';
+import 'package:opennutritracker/features/settings/presentation/widgets/custom_macro_goals_dialog.dart';
+import 'package:opennutritracker/generated/l10n.dart';
+import 'package:provider/provider.dart';
+
+import '../../../../helpers/fake_reload_blocs.dart';
+import '../../../../helpers/test_l10n.dart';
+
+typedef _Grams = ({double carbs, double protein, double fat});
+
+class _FakeSettingsBloc extends Fake implements SettingsBloc {
+  final List<String> calls;
+  final _Grams? stored;
+  bool saved = false;
+  _Grams? savedGrams;
+
+  _FakeSettingsBloc(this.calls, {this.stored});
+
+  @override
+  Future<_Grams?> getCustomMacroGoalGrams() async => stored;
+
+  @override
+  Future<_Grams> getBaseMacroGoalGrams() async =>
+      (carbs: 375.4, protein: 93.6, fat: 69.4);
+
+  @override
+  Future<void> setCustomMacroGoalGrams(_Grams? grams) async {
+    saved = true;
+    savedGrams = grams;
+  }
+
+  @override
+  Future<DateTime> getCurrentLogicalDay() async => DateTime(2026, 10, 10);
+
+  @override
+  Future<void> updateTrackedDay(DateTime day) async {
+    await Future<void>.delayed(Duration.zero);
+    calls.add('updateTrackedDay');
+  }
+
+  @override
+  void add(SettingsEvent event) {}
+}
+
+class _FakeHomeBloc extends Fake implements HomeBloc {
+  @override
+  void add(HomeEvent event) {}
+}
+
+Future<void> _open(WidgetTester tester, _FakeSettingsBloc settingsBloc) async {
+  await tester.pumpWidget(
+    ChangeNotifierProvider(
+      create: (_) => EnergyUnitProvider(),
+      child: MaterialApp(
+        localizationsDelegates: const [S.delegate],
+        supportedLocales: S.supportedLocales,
+        home: Scaffold(
+          body: Builder(
+            builder: (context) => ElevatedButton(
+              onPressed: () => showDialog<void>(
+                context: context,
+                builder: (_) => CustomMacroGoalsDialog(
+                  settingsBloc: settingsBloc,
+                  homeBloc: _FakeHomeBloc(),
+                ),
+              ),
+              child: const Text('Open'),
+            ),
+          ),
+        ),
+      ),
+    ),
+  );
+  await tester.tap(find.text('Open'));
+  await tester.pumpAndSettle();
+}
+
+Finder _field(String identifier) => find.descendant(
+  of: find.bySemanticsIdentifier(identifier),
+  matching: find.byType(TextField),
+);
+
+void main() {
+  late ReloadRecorder recorder;
+
+  setUp(() {
+    recorder = ReloadRecorder()..register();
+  });
+
+  tearDown(() async => locator.reset());
+
+  testWidgets('starts off, pre-filled with the calculated goals', (
+    tester,
+  ) async {
+    final settingsBloc = _FakeSettingsBloc(recorder.log);
+    await _open(tester, settingsBloc);
+
+    final carbs = tester.widget<TextField>(_field('custom-macro-goals-carbs'));
+    expect(carbs.controller!.text, '375');
+    expect(carbs.enabled, isFalse);
+    expect(
+      tester.widget<SwitchListTile>(find.byType(SwitchListTile)).value,
+      isFalse,
+    );
+  });
+
+  testWidgets('saves the typed grams and refreshes today\'s goals', (
+    tester,
+  ) async {
+    final settingsBloc = _FakeSettingsBloc(recorder.log);
+    await _open(tester, settingsBloc);
+
+    await tester.tap(find.byType(Switch));
+    await tester.pump();
+    await tester.enterText(_field('custom-macro-goals-carbs'), '200');
+    await tester.enterText(_field('custom-macro-goals-fat'), '70');
+    await tester.enterText(_field('custom-macro-goals-protein'), '150');
+    await tester.pump();
+
+    // 200 × 4 + 70 × 9 + 150 × 4
+    expect(find.text('2030 ${l10nEn.kcalLabel}'), findsOneWidget);
+
+    await tester.tap(find.text(l10nEn.dialogOKLabel));
+    await tester.pumpAndSettle();
+
+    expect(settingsBloc.savedGrams, (carbs: 200.0, protein: 150.0, fat: 70.0));
+    expect(recorder.log.first, 'updateTrackedDay');
+    expect(recorder.diaryReloaded, isTrue);
+    expect(recorder.trendsReloaded, isTrue);
+    expect(find.byType(CustomMacroGoalsDialog), findsNothing);
+  });
+
+  testWidgets('all-zero grams cannot be saved', (tester) async {
+    final settingsBloc = _FakeSettingsBloc(recorder.log);
+    await _open(tester, settingsBloc);
+
+    await tester.tap(find.byType(Switch));
+    await tester.pump();
+    for (final id in [
+      'custom-macro-goals-carbs',
+      'custom-macro-goals-fat',
+      'custom-macro-goals-protein',
+    ]) {
+      await tester.enterText(_field(id), '0');
+    }
+    await tester.pump();
+
+    expect(
+      find.text(
+        l10nEn.settingsCustomMacroGoalsInvalid(
+          CustomMacroGoalsDialog.maxMacroGrams,
+        ),
+      ),
+      findsOneWidget,
+    );
+    await tester.tap(find.text(l10nEn.dialogOKLabel));
+    await tester.pumpAndSettle();
+    expect(settingsBloc.saved, isFalse);
+  });
+
+  testWidgets('switching off clears the custom goals', (tester) async {
+    final settingsBloc = _FakeSettingsBloc(
+      recorder.log,
+      stored: (carbs: 200, protein: 150, fat: 70),
+    );
+    await _open(tester, settingsBloc);
+
+    expect(
+      tester
+          .widget<TextField>(_field('custom-macro-goals-fat'))
+          .controller!
+          .text,
+      '70',
+    );
+    await tester.tap(find.byType(Switch));
+    await tester.pump();
+    await tester.tap(find.text(l10nEn.dialogOKLabel));
+    await tester.pumpAndSettle();
+
+    expect(settingsBloc.saved, isTrue);
+    expect(settingsBloc.savedGrams, isNull);
+  });
+}
