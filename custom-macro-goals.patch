+++ b/test/features/settings/presentation/widgets/custom_kcal_goal_dialog_test.dart
@@ -0,0 +1,170 @@
+import 'package:flutter/material.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:opennutritracker/core/utils/energy_unit_provider.dart';
+import 'package:opennutritracker/core/utils/locator.dart';
+import 'package:opennutritracker/features/home/presentation/bloc/home_bloc.dart';
+import 'package:opennutritracker/features/settings/presentation/bloc/settings_bloc.dart';
+import 'package:opennutritracker/features/settings/presentation/widgets/custom_kcal_goal_dialog.dart';
+import 'package:opennutritracker/generated/l10n.dart';
+import 'package:provider/provider.dart';
+
+import '../../../../helpers/fake_reload_blocs.dart';
+import '../../../../helpers/test_l10n.dart';
+
+class _FakeSettingsBloc extends Fake implements SettingsBloc {
+  final List<String> calls;
+  final double? stored;
+  bool saved = false;
+  double? savedKcal;
+
+  _FakeSettingsBloc(this.calls, {this.stored});
+
+  @override
+  Future<double?> getCustomKcalGoal() async => stored;
+
+  @override
+  Future<double> getBaseKcalGoal() async => 2512.6;
+
+  @override
+  Future<void> setCustomKcalGoal(double? kcal) async {
+    saved = true;
+    savedKcal = kcal;
+  }
+
+  @override
+  Future<DateTime> getCurrentLogicalDay() async => DateTime(2026, 10, 10);
+
+  @override
+  Future<void> updateTrackedDay(DateTime day) async {
+    await Future<void>.delayed(Duration.zero);
+    calls.add('updateTrackedDay');
+  }
+
+  @override
+  void add(SettingsEvent event) {}
+}
+
+class _FakeHomeBloc extends Fake implements HomeBloc {
+  @override
+  void add(HomeEvent event) {}
+}
+
+Future<void> _open(
+  WidgetTester tester,
+  _FakeSettingsBloc settingsBloc, {
+  bool usesKilojoules = false,
+}) async {
+  await tester.pumpWidget(
+    ChangeNotifierProvider(
+      create: (_) => EnergyUnitProvider(usesKilojoules: usesKilojoules),
+      child: MaterialApp(
+        localizationsDelegates: const [S.delegate],
+        supportedLocales: S.supportedLocales,
+        home: Scaffold(
+          body: Builder(
+            builder: (context) => ElevatedButton(
+              onPressed: () => showDialog<void>(
+                context: context,
+                builder: (_) => CustomKcalGoalDialog(
+                  settingsBloc: settingsBloc,
+                  homeBloc: _FakeHomeBloc(),
+                ),
+              ),
+              child: const Text('Open'),
+            ),
+          ),
+        ),
+      ),
+    ),
+  );
+  await tester.tap(find.text('Open'));
+  await tester.pumpAndSettle();
+}
+
+Finder get _field => find.descendant(
+  of: find.bySemanticsIdentifier('custom-kcal-goal-input'),
+  matching: find.byType(TextField),
+);
+
+void main() {
+  late ReloadRecorder recorder;
+
+  setUp(() {
+    recorder = ReloadRecorder()..register();
+  });
+
+  tearDown(() async => locator.reset());
+
+  testWidgets('starts off, pre-filled with the calculated goal', (
+    tester,
+  ) async {
+    await _open(tester, _FakeSettingsBloc(recorder.log));
+
+    final field = tester.widget<TextField>(_field);
+    expect(field.controller!.text, '2513');
+    expect(field.enabled, isFalse);
+  });
+
+  testWidgets('saves the typed goal and refreshes today\'s goals', (
+    tester,
+  ) async {
+    final settingsBloc = _FakeSettingsBloc(recorder.log);
+    await _open(tester, settingsBloc);
+
+    await tester.tap(find.byType(Switch));
+    await tester.pump();
+    await tester.enterText(_field, '2200');
+    await tester.pump();
+    await tester.tap(find.text(l10nEn.dialogOKLabel));
+    await tester.pumpAndSettle();
+
+    expect(settingsBloc.savedKcal, 2200);
+    expect(recorder.log.first, 'updateTrackedDay');
+    expect(recorder.diaryReloaded, isTrue);
+    expect(recorder.trendsReloaded, isTrue);
+    expect(find.byType(CustomKcalGoalDialog), findsNothing);
+  });
+
+  testWidgets('a goal outside the range cannot be saved', (tester) async {
+    final settingsBloc = _FakeSettingsBloc(recorder.log);
+    await _open(tester, settingsBloc);
+
+    await tester.tap(find.byType(Switch));
+    await tester.pump();
+    await tester.enterText(_field, '100');
+    await tester.pump();
+
+    expect(
+      find.text(l10nEn.settingsCustomKcalGoalInvalid(500, 10000)),
+      findsOneWidget,
+    );
+    await tester.tap(find.text(l10nEn.dialogOKLabel));
+    await tester.pumpAndSettle();
+    expect(settingsBloc.saved, isFalse);
+  });
+
+  testWidgets('kJ input is stored as kcal, and an untouched field keeps the '
+      'stored value', (tester) async {
+    final settingsBloc = _FakeSettingsBloc(recorder.log, stored: 2000);
+    await _open(tester, settingsBloc, usesKilojoules: true);
+
+    // 2000 kcal × 4.184 = 8368 kJ.
+    expect(tester.widget<TextField>(_field).controller!.text, '8368');
+    await tester.tap(find.text(l10nEn.dialogOKLabel));
+    await tester.pumpAndSettle();
+    expect(settingsBloc.savedKcal, 2000);
+  });
+
+  testWidgets('switching off clears the custom goal', (tester) async {
+    final settingsBloc = _FakeSettingsBloc(recorder.log, stored: 2000);
+    await _open(tester, settingsBloc);
+
+    await tester.tap(find.byType(Switch));
+    await tester.pump();
+    await tester.tap(find.text(l10nEn.dialogOKLabel));
+    await tester.pumpAndSettle();
+
+    expect(settingsBloc.saved, isTrue);
+    expect(settingsBloc.savedKcal, isNull);
+  });
+}
