diff --git a/test/unit_test/custom_macro_goals_test.dart b/test/unit_test/custom_macro_goals_test.dart
new file mode 100644
index 0000000..a1d71ed
--- /dev/null
+++ b/test/unit_test/custom_macro_goals_test.dart
@@ -0,0 +1,329 @@
+import 'package:flutter_test/flutter_test.dart';
+import 'package:opennutritracker/core/data/dbo/config_dbo.dart';
+import 'package:opennutritracker/core/data/repository/config_repository.dart';
+import 'package:opennutritracker/core/data/repository/user_activity_repository.dart';
+import 'package:opennutritracker/core/data/repository/user_repository.dart';
+import 'package:opennutritracker/core/domain/entity/app_theme_entity.dart';
+import 'package:opennutritracker/core/domain/entity/config_entity.dart';
+import 'package:opennutritracker/core/domain/entity/user_activity_entity.dart';
+import 'package:opennutritracker/core/domain/entity/user_entity.dart';
+import 'package:opennutritracker/core/domain/entity/user_gender_entity.dart';
+import 'package:opennutritracker/core/domain/entity/user_pal_entity.dart';
+import 'package:opennutritracker/core/domain/entity/user_weight_goal_entity.dart';
+import 'package:opennutritracker/core/domain/usecase/get_kcal_goal_breakdown_usecase.dart';
+import 'package:opennutritracker/core/domain/usecase/get_kcal_goal_usecase.dart';
+import 'package:opennutritracker/core/domain/usecase/get_macro_goal_usecase.dart';
+import 'package:opennutritracker/core/utils/calc/calorie_goal_calc.dart';
+import 'package:opennutritracker/core/utils/calc/macro_calc.dart';
+import 'package:opennutritracker/features/settings/domain/goal_settings_backup.dart';
+
+import '../fixture/physical_activity_entity_fixtures.dart';
+
+/// Also covers the custom daily kcal goal, which replaces the calculated
+/// goal but leaves the macros to the split, and yields to custom macros.
+///
+/// Custom daily macro goals in grams: while all three are set, the kcal
+/// goal is the energy they provide (plus activities) and the macro goals
+/// are the grams the user entered, instead of values derived from the
+/// profile.
+class _FakeUserRepository extends Fake implements UserRepository {
+  final UserEntity user;
+
+  _FakeUserRepository(this.user);
+
+  @override
+  Future<UserEntity> getUserData() async => user;
+}
+
+class _FakeConfigRepository extends Fake implements ConfigRepository {
+  final ConfigEntity config;
+
+  _FakeConfigRepository(this.config);
+
+  @override
+  Future<ConfigEntity> getConfig() async => config;
+}
+
+class _FakeUserActivityRepository extends Fake
+    implements UserActivityRepository {
+  final List<UserActivityEntity> activities;
+
+  _FakeUserActivityRepository(this.activities);
+
+  @override
+  Future<List<UserActivityEntity>> getAllUserActivityByDate(
+    DateTime dateTime, {
+    int dayStartOffsetHours = 0,
+    int dayStartOffsetMinutes = 0,
+  }) async => activities;
+}
+
+ConfigEntity _config({
+  double? carbs,
+  double? protein,
+  double? fat,
+  double? kcalAdjustment = 250,
+  double? kcalGoal,
+}) => ConfigEntity(
+  false,
+  false,
+  false,
+  AppThemeEntity.system,
+  userKcalAdjustment: kcalAdjustment,
+  userCarbGoalPct: 0.5,
+  userProteinGoalPct: 0.2,
+  userFatGoalPct: 0.3,
+  userCarbGoalGrams: carbs,
+  userProteinGoalGrams: protein,
+  userFatGoalGrams: fat,
+  userKcalGoal: kcalGoal,
+);
+
+void main() {
+  final now = DateTime.now();
+  final yesterday = now.subtract(const Duration(days: 1));
+  final user = UserEntity(
+    birthday: DateTime(yesterday.year - 30, yesterday.month, yesterday.day),
+    heightCM: 180.0,
+    weightKG: 80.0,
+    gender: UserGenderEntity.male,
+    goal: UserWeightGoalEntity.maintainWeight,
+    pal: UserPALEntity.active,
+  );
+
+  // 200 g carbs, 150 g protein, 70 g fat = 800 + 600 + 630 = 2030 kcal.
+  final custom = _config(carbs: 200, protein: 150, fat: 70);
+  const customKcal = 2030.0;
+
+  ({
+    GetKcalGoalUsecase kcal,
+    GetMacroGoalUsecase macro,
+    GetKcalGoalBreakdownUsecase breakdown,
+  })
+  usecases(
+    ConfigEntity config, [
+    List<UserActivityEntity> activities = const [],
+  ]) {
+    final userRepo = _FakeUserRepository(user);
+    final configRepo = _FakeConfigRepository(config);
+    final activityRepo = _FakeUserActivityRepository(activities);
+    return (
+      kcal: GetKcalGoalUsecase(userRepo, configRepo, activityRepo),
+      macro: GetMacroGoalUsecase(configRepo),
+      breakdown: GetKcalGoalBreakdownUsecase(
+        userRepo,
+        configRepo,
+        activityRepo,
+      ),
+    );
+  }
+
+  group('ConfigEntity.hasCustomMacroGoals', () {
+    test('is on only when all three grams are set', () {
+      expect(custom.hasCustomMacroGoals, isTrue);
+      expect(custom.customMacroGoalsKcal, customKcal);
+      expect(_config().hasCustomMacroGoals, isFalse);
+      expect(_config(carbs: 200, protein: 150).hasCustomMacroGoals, isFalse);
+    });
+
+    test('is off for values that would make a broken goal', () {
+      expect(
+        _config(carbs: 0, protein: 0, fat: 0).hasCustomMacroGoals,
+        isFalse,
+      );
+      expect(
+        _config(carbs: -10, protein: 150, fat: 70).hasCustomMacroGoals,
+        isFalse,
+      );
+      expect(
+        _config(carbs: double.nan, protein: 150, fat: 70).hasCustomMacroGoals,
+        isFalse,
+      );
+    });
+  });
+
+  test('without custom grams the goals are calculated as before', () async {
+    final u = usecases(_config());
+    final kcal = await u.kcal.getKcalGoal();
+
+    expect(
+      kcal,
+      CalorieGoalCalc.getTotalKcalGoal(user, 0, kcalUserAdjustment: 250),
+    );
+    expect(await u.macro.getCarbsGoal(kcal), kcal * 0.5 / 4);
+  });
+
+  test('custom grams replace the calculated kcal and macro goals', () async {
+    final u = usecases(custom);
+    final kcal = await u.kcal.getKcalGoal();
+
+    // The kcal adjustment and the split no longer apply.
+    expect(kcal, customKcal);
+    expect(await u.macro.getCarbsGoal(kcal), 200);
+    expect(await u.macro.getProteinsGoal(kcal), 150);
+    expect(await u.macro.getFatsGoal(kcal), 70);
+  });
+
+  test('activities still add to a custom goal', () async {
+    final activities = [
+      UserActivityEntity(
+        'a1',
+        45,
+        400,
+        now,
+        PhysicalActivityFixtures.moderateBicycling,
+      ),
+    ];
+    final u = usecases(custom, activities);
+    final kcal = await u.kcal.getKcalGoal();
+
+    expect(kcal, customKcal + 400);
+    // The burned kcal is split the default way, as a logged activity adds
+    // to a tracked day, on top of the user's own grams.
+    expect(
+      await u.macro.getCarbsGoal(kcal),
+      closeTo(200 + MacroCalc.getTotalCarbsGoal(400), 1e-9),
+    );
+    expect(
+      await u.macro.getFatsGoal(kcal),
+      closeTo(70 + MacroCalc.getTotalFatsGoal(400), 1e-9),
+    );
+    expect(
+      await u.macro.getProteinsGoal(kcal),
+      closeTo(150 + MacroCalc.getTotalProteinsGoal(400), 1e-9),
+    );
+
+    final breakdown = await u.breakdown.getBreakdown();
+    expect(breakdown.usesCustomMacroGoals, isTrue);
+    expect(breakdown.customMacroGoalsKcal, customKcal);
+    expect(breakdown.totalKcalGoal, kcal);
+    expect(breakdown.carbsGoalGrams, await u.macro.getCarbsGoal(kcal));
+    expect(breakdown.fatsGoalGrams, await u.macro.getFatsGoal(kcal));
+    expect(breakdown.proteinsGoalGrams, await u.macro.getProteinsGoal(kcal));
+    expect(
+      breakdown.carbsFractionGoal +
+          breakdown.fatsFractionGoal +
+          breakdown.proteinsFractionGoal,
+      closeTo(1, 1e-9),
+    );
+  });
+
+  test('a calculated breakdown does not report custom goals', () async {
+    final breakdown = await usecases(_config()).breakdown.getBreakdown();
+
+    expect(breakdown.usesCustomMacroGoals, isFalse);
+    expect(breakdown.customMacroGoalsKcal, isNull);
+  });
+
+  group('GoalSettingsBackup custom macro grams', () {
+    test('round-trip through JSON', () {
+      final config = ConfigDBO.empty()
+        ..userCarbGoalGrams = 200
+        ..userProteinGoalGrams = 150
+        ..userFatGoalGrams = 70;
+      final restored = GoalSettingsBackup.fromJson(
+        GoalSettingsBackup.fromConfigDBO(config).toJson(),
+      )!;
+
+      expect(restored.carbGoalGrams, 200);
+      expect(restored.proteinGoalGrams, 150);
+      expect(restored.fatGoalGrams, 70);
+    });
+
+    test('an older backup without them restores calculated goals', () {
+      final restored = GoalSettingsBackup.fromJson({'version': 1})!;
+
+      expect(restored.carbGoalGrams, isNull);
+      expect(restored.proteinGoalGrams, isNull);
+      expect(restored.fatGoalGrams, isNull);
+    });
+
+    test('rejects a partial or out-of-range set', () {
+      expect(
+        () => GoalSettingsBackup.fromJson({'version': 1, 'carbGoalGrams': 200}),
+        throwsFormatException,
+      );
+      expect(
+        () => GoalSettingsBackup.fromJson({
+          'version': 1,
+          'carbGoalGrams': 200,
+          'proteinGoalGrams': -1,
+          'fatGoalGrams': 70,
+        }),
+        throwsFormatException,
+      );
+    });
+  });
+
+  group('custom kcal goal', () {
+    final activities = [
+      UserActivityEntity(
+        'a1',
+        30,
+        300,
+        now,
+        PhysicalActivityFixtures.moderateBicycling,
+      ),
+    ];
+
+    test('replaces the calculated goal; macros follow the split', () async {
+      final u = usecases(_config(kcalGoal: 2200));
+      final kcal = await u.kcal.getKcalGoal();
+
+      // The kcal adjustment no longer applies.
+      expect(kcal, 2200);
+      expect(await u.macro.getCarbsGoal(kcal), 2200 * 0.5 / 4);
+      expect(await u.macro.getProteinsGoal(kcal), 2200 * 0.2 / 4);
+      expect(await u.macro.getFatsGoal(kcal), 2200 * 0.3 / 9);
+    });
+
+    test('activities still add on top, and the breakdown agrees', () async {
+      final u = usecases(_config(kcalGoal: 2200), activities);
+      final kcal = await u.kcal.getKcalGoal();
+      final breakdown = await u.breakdown.getBreakdown();
+
+      expect(kcal, 2500);
+      expect(breakdown.usesCustomKcalGoal, isTrue);
+      expect(breakdown.usesCustomMacroGoals, isFalse);
+      expect(breakdown.customKcalGoal, 2200);
+      expect(breakdown.totalKcalGoal, kcal);
+      expect(breakdown.carbsGoalGrams, await u.macro.getCarbsGoal(kcal));
+      expect(breakdown.carbsFractionGoal, 0.5);
+    });
+
+    test('custom macro goals take precedence over it', () async {
+      final config = _config(kcalGoal: 2200, carbs: 200, protein: 150, fat: 70);
+      final u = usecases(config);
+
+      expect(config.hasCustomKcalGoal, isFalse);
+      expect(await u.kcal.getKcalGoal(), customKcal);
+      final breakdown = await u.breakdown.getBreakdown();
+      expect(breakdown.usesCustomKcalGoal, isFalse);
+      expect(breakdown.usesCustomMacroGoals, isTrue);
+    });
+
+    test('a zero, negative or non-finite value reads as off', () {
+      for (final bad in [0.0, -100.0, double.nan, double.infinity]) {
+        expect(
+          _config(kcalGoal: bad).hasCustomKcalGoal,
+          isFalse,
+          reason: '$bad',
+        );
+      }
+    });
+
+    test('round-trips through a backup and validates its range', () {
+      final restored = GoalSettingsBackup.fromJson(
+        GoalSettingsBackup.fromConfigDBO(
+          ConfigDBO.empty()..userKcalGoal = 2200,
+        ).toJson(),
+      )!;
+      expect(restored.kcalGoal, 2200);
+      expect(GoalSettingsBackup.fromJson({'version': 1})!.kcalGoal, isNull);
+      expect(
+        () => GoalSettingsBackup.fromJson({'version': 1, 'kcalGoal': 100}),
+        throwsFormatException,
+      );
+    });
+  });
+}
