diff --git a/lib/features/settings/presentation/widgets/custom_macro_goals_dialog.dart b/lib/features/settings/presentation/widgets/custom_macro_goals_dialog.dart
new file mode 100644
index 0000000..d7c912a
--- /dev/null
+++ b/lib/features/settings/presentation/widgets/custom_macro_goals_dialog.dart
@@ -0,0 +1,242 @@
+import 'package:flutter/material.dart';
+import 'package:flutter/services.dart';
+import 'package:opennutritracker/core/utils/calc/macro_calc.dart';
+import 'package:opennutritracker/core/utils/energy_display.dart';
+import 'package:opennutritracker/core/utils/reload_diary_and_trends.dart';
+import 'package:opennutritracker/features/home/presentation/bloc/home_bloc.dart';
+import 'package:opennutritracker/features/settings/presentation/bloc/settings_bloc.dart';
+import 'package:opennutritracker/generated/l10n.dart';
+
+/// Lets the user enter their own daily macro goals in grams instead of
+/// having them derived from the calculated kcal goal and the macro split.
+/// While on, the daily kcal goal is the energy the grams add up to (plus
+/// logged activity, as before) — see `GetKcalGoalUsecase`.
+class CustomMacroGoalsDialog extends StatefulWidget {
+  /// Upper bound for each macro field, in grams.
+  static const int maxMacroGrams = 1000;
+
+  final SettingsBloc settingsBloc;
+  final HomeBloc homeBloc;
+
+  const CustomMacroGoalsDialog({
+    super.key,
+    required this.settingsBloc,
+    required this.homeBloc,
+  });
+
+  @override
+  State<CustomMacroGoalsDialog> createState() => _CustomMacroGoalsDialogState();
+}
+
+class _CustomMacroGoalsDialogState extends State<CustomMacroGoalsDialog> {
+  bool _loaded = false;
+  bool _enabled = false;
+
+  late final TextEditingController _carbsController;
+  late final TextEditingController _fatController;
+  late final TextEditingController _proteinController;
+
+  @override
+  void initState() {
+    super.initState();
+    _carbsController = TextEditingController();
+    _fatController = TextEditingController();
+    _proteinController = TextEditingController();
+    _load();
+  }
+
+  @override
+  void dispose() {
+    _carbsController.dispose();
+    _fatController.dispose();
+    _proteinController.dispose();
+    super.dispose();
+  }
+
+  Future<void> _load() async {
+    final custom = await widget.settingsBloc.getCustomMacroGoalGrams();
+    // Off: start from the calculated goals the dashboard shows today, so
+    // switching on is a tweak of familiar numbers rather than a blank form.
+    final grams = custom ?? await widget.settingsBloc.getBaseMacroGoalGrams();
+    if (!mounted) return;
+    setState(() {
+      _enabled = custom != null;
+      _carbsController.text = grams.carbs.round().toString();
+      _fatController.text = grams.fat.round().toString();
+      _proteinController.text = grams.protein.round().toString();
+      _loaded = true;
+    });
+  }
+
+  int? _parse(TextEditingController controller) {
+    final value = int.tryParse(controller.text);
+    if (value == null || value < 0) return null;
+    return value > CustomMacroGoalsDialog.maxMacroGrams ? null : value;
+  }
+
+  /// The entered grams, or null when any field is empty, out of range, or
+  /// all three are zero (a 0 kcal goal).
+  ({double carbs, double protein, double fat})? get _grams {
+    final carbs = _parse(_carbsController);
+    final fat = _parse(_fatController);
+    final protein = _parse(_proteinController);
+    if (carbs == null || fat == null || protein == null) return null;
+    if (carbs + fat + protein == 0) return null;
+    return (
+      carbs: carbs.toDouble(),
+      protein: protein.toDouble(),
+      fat: fat.toDouble(),
+    );
+  }
+
+  Future<void> _save() async {
+    final grams = _grams;
+    if (_enabled && grams == null) return;
+    await widget.settingsBloc.setCustomMacroGoalGrams(_enabled ? grams : null);
+    widget.settingsBloc.add(LoadSettingsEvent());
+    widget.homeBloc.add(const LoadItemsEvent());
+    // Recompute today's stored goals so the diary reflects the change
+    // straight away instead of from tomorrow on.
+    await widget.settingsBloc.updateTrackedDay(
+      await widget.settingsBloc.getCurrentLogicalDay(),
+    );
+    reloadDiaryAndTrends();
+    if (!mounted) return;
+    Navigator.of(context).pop();
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    final s = S.of(context);
+    final grams = _grams;
+    final canSave = _loaded && (!_enabled || grams != null);
+    return AlertDialog(
+      title: Text(
+        s.settingsCustomMacroGoalsLabel,
+        maxLines: 2,
+        overflow: TextOverflow.ellipsis,
+      ),
+      content: !_loaded
+          ? const SizedBox(
+              height: 80,
+              child: Center(child: CircularProgressIndicator()),
+            )
+          : SingleChildScrollView(
+              child: Column(
+                mainAxisSize: MainAxisSize.min,
+                crossAxisAlignment: CrossAxisAlignment.stretch,
+                children: [
+                  Semantics(
+                    identifier: 'custom-macro-goals-switch',
+                    child: SwitchListTile(
+                      contentPadding: EdgeInsets.zero,
+                      title: Text(s.settingsCustomMacroGoalsSwitchLabel),
+                      value: _enabled,
+                      onChanged: (value) => setState(() => _enabled = value),
+                    ),
+                  ),
+                  Text(
+                    s.settingsCustomMacroGoalsDescription,
+                    style: Theme.of(context).textTheme.bodySmall,
+                  ),
+                  const SizedBox(height: 16),
+                  _gramsField(
+                    context,
+                    identifier: 'custom-macro-goals-carbs',
+                    label: s.carbsLabel,
+                    controller: _carbsController,
+                  ),
+                  const SizedBox(height: 12),
+                  _gramsField(
+                    context,
+                    identifier: 'custom-macro-goals-fat',
+                    label: s.fatLabel,
+                    controller: _fatController,
+                  ),
+                  const SizedBox(height: 12),
+                  _gramsField(
+                    context,
+                    identifier: 'custom-macro-goals-protein',
+                    label: s.proteinLabel,
+                    controller: _proteinController,
+                  ),
+                  const SizedBox(height: 16),
+                  if (_enabled && grams == null)
+                    Text(
+                      s.settingsCustomMacroGoalsInvalid(
+                        CustomMacroGoalsDialog.maxMacroGrams,
+                      ),
+                      style: TextStyle(
+                        color: Theme.of(context).colorScheme.error,
+                      ),
+                    )
+                  else if (_enabled)
+                    Row(
+                      children: [
+                        Expanded(
+                          child: Text(
+                            s.settingsCustomMacroGoalsTotalLabel,
+                            style: Theme.of(context).textTheme.titleMedium,
+                          ),
+                        ),
+                        Text(
+                          EnergyDisplay.formatWithUnit(
+                            context,
+                            MacroCalc.getKcalFromMacroGrams(
+                              carbsGrams: grams!.carbs,
+                              fatsGrams: grams.fat,
+                              proteinsGrams: grams.protein,
+                            ),
+                          ),
+                          style: Theme.of(context).textTheme.titleMedium
+                              ?.copyWith(
+                                color: Theme.of(context).colorScheme.primary,
+                                fontWeight: FontWeight.bold,
+                              ),
+                        ),
+                      ],
+                    ),
+                ],
+              ),
+            ),
+      actions: [
+        TextButton(
+          onPressed: () => Navigator.of(context).pop(),
+          child: Text(s.dialogCancelLabel),
+        ),
+        Semantics(
+          identifier: 'custom-macro-goals-save',
+          child: TextButton(
+            onPressed: canSave ? _save : null,
+            child: Text(s.dialogOKLabel),
+          ),
+        ),
+      ],
+    );
+  }
+
+  Widget _gramsField(
+    BuildContext context, {
+    required String identifier,
+    required String label,
+    required TextEditingController controller,
+  }) {
+    return Semantics(
+      identifier: identifier,
+      child: TextField(
+        controller: controller,
+        enabled: _enabled,
+        keyboardType: TextInputType.number,
+        inputFormatters: [FilteringTextInputFormatter.digitsOnly],
+        textAlign: TextAlign.right,
+        decoration: InputDecoration(
+          labelText: label,
+          suffixText: S.of(context).gramUnit,
+          isDense: true,
+          border: const OutlineInputBorder(),
+        ),
+        onChanged: (_) => setState(() {}),
+      ),
+    );
+  }
+}
